# Lokalnie: skopiuj do .env i uruchom `npx vercel dev`.
# Na Vercel: Project -> Settings -> Environment Variables.
ANTHROPIC_API_KEY=sk-ant-...
# Opcjonalnie: hasło do strony (chroni Twój klucz przed obcymi). Jeśli ustawione, Smiri poprosi o nie raz.
SITE_PASSWORD=
# Opcjonalnie: lista dozwolonych modeli, po przecinku.
ALLOWED_MODELS=claude-sonnet-5-5,claude-haiku-5-5
